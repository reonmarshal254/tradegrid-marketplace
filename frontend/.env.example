# Google OAuth client ID (same one as backend GOOGLE_CLIENT_ID)
# Authorized redirect URI in Google Cloud Console:
#   http://localhost:5173/auth/google/callback  (and production origin + /auth/google/callback)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional: backend API base URL when not using the Vite dev proxy
VITE_API_URL=
